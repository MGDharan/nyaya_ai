APP_NAME=NyayaAI
ENVIRONMENT=development
DATA_DIR=./data
CHROMA_DIR=./data/chroma
# When running locally (no Docker), leave CHROMA_HOST blank to use embedded mode.
# When running via docker-compose, CHROMA_HOST=chromadb is set automatically.
CHROMA_HOST=
CHROMA_PORT=8001
EMBEDDING_MODEL=intfloat/multilingual-e5-small
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ADMIN_API_KEY=change-this-long-random-secret
MAX_UPLOAD_MB=25
TOP_K=7

# Supabase Auth & Realtime Database
SUPABASE_URL=https://sfkvzaljndycgrsszusi.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
